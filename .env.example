# Public origin of the site, no trailing slash. REQUIRED in production (canonicals, hreflang, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Keep OFF for the demo. Set to "on" ONLY on the final production domain.
NEXT_PUBLIC_INDEXING=off

# Tracking (leave empty until real IDs exist). If GTM is set, GA4 should be configured inside GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Local SEO data (see CLIENT-DATA-NEEDED.md)
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GBP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-side: JSON POST target for the contact form (Make / Zapier / n8n / Formspree-compatible). Empty = demo mode.
CONTACT_WEBHOOK_URL=
