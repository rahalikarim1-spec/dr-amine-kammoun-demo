{
  "name": "dr-amine-kammoun-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (FR/AR) SEO-first demo website for Dr Amine Kammoun, gynécologue-obstétricien, Ain Zaghouan Nord, Tunis.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
